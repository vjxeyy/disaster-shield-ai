# ---------------------------------------------------------------
# Disaster-Shield AI — environment variables
# Copy to .env.local (local) or add in Vercel → Project → Settings → Environment Variables.
#
# With NONE of these set, the app runs in DEMO MODE: simulated Chennai data stored in the
# browser (localStorage), demo role switching, no database required.
# ---------------------------------------------------------------

# Supabase project URL and anon (public) key — enables Supabase mode (auth + Postgres + RLS + realtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by /api/admin/users so administrators can invite staff accounts.
# NEVER prefix with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: force demo mode even when Supabase variables are present (e.g. for a judging laptop).
# NEXT_PUBLIC_DATA_MODE=demo
